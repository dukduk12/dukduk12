--- a/src/create-3d-contrib.ts
+++ b/src/create-3d-contrib.ts
@@ -351,2 +351,23 @@ export const create3DContrib = (
     });
+
+    let previousMonth = -1;
+    userInfo.contributionCalendar.forEach((cal) => {
+        const month = cal.date.getUTCMonth();
+        if (month === previousMonth) {
+            return;
+        }
+        previousMonth = month;
+        const week = Math.floor(
+            (toEpochDays(cal.date) - sundayOfFirstWeek) / 7,
+        );
+        group
+            .append('text')
+            .attr('x', util.toFixed(offsetX + (week - 7) * dx))
+            .attr('y', util.toFixed(offsetY + (week + 7) * dy + 22))
+            .attr('text-anchor', 'middle')
+            .attr('fill', '#e4c96a')
+            .attr('font-size', '14px')
+            .attr('font-weight', '600')
+            .text(cal.date.toLocaleString('en', { month: 'short' }));
+    });
 };
